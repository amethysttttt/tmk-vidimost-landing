# Postgres (обязательно для CRM). Пример: postgresql://user:pass@host:5432/crm
DATABASE_URL=

# Вход в /crm
CRM_LOGIN=admin
# Для продакшена предпочтительнее CRM_PASSWORD_HASH (bcrypt). CRM_PASSWORD — только для локальной разработки.
CRM_PASSWORD=
# CRM_PASSWORD_HASH=
CRM_SESSION_SECRET=

# Секрет для ingest с корпоративного сайта (заголовок X-CRM-Secret)
CRM_INGEST_SECRET=change-me-long-random

# Публичный URL CRM (ссылки в письмах)
CRM_PUBLIC_URL=https://ai.tmk-technohorizon.kz

# Уведомления о заявках (личный email по ТЗ)
NOTIFY_EMAIL=kaelggbet@gmail.com

# SMTP для писем CRM (можно тот же ящик, что и для форм, или отдельный)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# LEAD_FROM_EMAIL=

# WhatsApp-уведомления на +77479071622 — блокер до подключения провайдера
# WHATSAPP_PROVIDER=
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_ID=

# Опциональный дубль SEO-заявок в Google Sheets (как раньше)
# LEADS_WEBHOOK_URL=
